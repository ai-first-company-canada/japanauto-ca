---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/sections/Navbar.astro';
import MenuDrawer from '../../components/sections/MenuDrawer.astro';
import CityPickerDialog from '../../components/sections/CityPickerDialog.astro';
import Footer from '../../components/sections/Footer.astro';
import Breadcrumb from '../../components/atoms/Breadcrumb.astro';

const url = Astro.url.toString();
const schemaLD = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://japanauto.ca/' },
      { '@type': 'ListItem', position: 2, name: 'Editorial policy', item: url },
    ],
  },
  {
    '@type': 'WebPage',
    '@id': `${url}#page`,
    name: 'Editorial policy — japanauto.ca',
    description: 'How we research, fact-check, and update articles on japanauto.ca.',
    url,
    inLanguage: 'en-CA',
    publisher: { '@id': 'https://japanauto.ca/#organization' },
  },
];
---
<BaseLayout
  title="Editorial policy — japanauto.ca"
  description="How japanauto.ca sources, fact-checks, dates and corrects its buying guides, brand guides and glossary, and how editorial stays separate from paid placements."
  canonical={url}
  schemaLD={schemaLD}
>
  <Navbar slot="navbar" />
  <MenuDrawer slot="menu-drawer" />
  <CityPickerDialog slot="city-picker" />
  <Footer slot="footer" />

  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'About', href: '/about/' },
      { label: 'Editorial policy' },
    ]}
  />

  <article class="section" style="padding-top:8px;max-width:720px">
    <h1 class="t-display-l" style="font-size:30px;line-height:38px;margin-bottom:16px">Editorial policy</h1>

    <p class="t-body-m" style="font-size:15px;line-height:23px;margin-bottom:14px">
      japanauto.ca publishes independent buying guides, regulatory explainers, and model deep-dives for Canadian buyers of used Japanese vehicles. We do not accept payment from manufacturers in exchange for editorial coverage. Sponsored placements, when they appear, are clearly labelled and isolated from editorial content.
    </p>

    <h2 class="t-h-l" style="font-size:20px;line-height:28px;margin:24px 0 10px">Sourcing</h2>
    <p class="t-body-m" style="font-size:15px;line-height:23px;margin-bottom:14px">
      Facts come from primary sources wherever one exists: the Government of Canada (canada.ca, tc.canada.ca, cbsa-asfc.gc.ca, statcan.gc.ca), provincial governments and dealer regulators (amvic.org, omvic.ca, vsabc.ca, opc.gouv.qc.ca), and manufacturers' Canadian sites. Each article and glossary entry lists its sources at the end. Where we could not confirm an exact figure, we say so or give a range rather than a precise-looking number.
    </p>

    <h2 class="t-h-l" style="font-size:20px;line-height:28px;margin:24px 0 10px">Fact-checking</h2>
    <p class="t-body-m" style="font-size:15px;line-height:23px;margin-bottom:14px">
      Before publication, and again at each review, an editor checks the article's claims against the sources it cites. Rules that change often (taxes, rebates, dealer licensing, import requirements, title branding) are checked against the government or regulator page itself. We do not currently use outside reviewers; when we do, they will be named on the article with their credentials.
    </p>

    <h2 class="t-h-l" style="font-size:20px;line-height:28px;margin:24px 0 10px">Updates</h2>
    <p class="t-body-m" style="font-size:15px;line-height:23px;margin-bottom:14px">
      Every article shows a <strong style="color:var(--color-ink-strong);font-weight:600">Last reviewed</strong> date: the last time its facts were rechecked, not just the last edit. We aim to recheck pages about taxes, rebates and regulator rules every quarter, and model and reliability guides at least once a year or after a major recall.
    </p>

    <h2 class="t-h-l" style="font-size:20px;line-height:28px;margin:24px 0 10px">Corrections</h2>
    <p class="t-body-m" style="font-size:15px;line-height:23px;margin-bottom:14px">
      If you spot an error, email <a href="mailto:editorial@japanauto.ca" style="color:var(--color-ink-strong);text-decoration:underline">editorial@japanauto.ca</a> with the page URL and, if you can, a source for the correct fact. We fix confirmed errors and update the Last reviewed date.
    </p>

    <h2 class="t-h-l" style="font-size:20px;line-height:28px;margin:24px 0 10px">Independence</h2>
    <p class="t-body-m" style="font-size:15px;line-height:23px;margin-bottom:14px">
      Dealers and salvage yards pay to list inventory and can buy featured placements. Paid placements are labelled and never appear inside articles. No dealer, manufacturer or advertiser sees or approves editorial content before publication.
    </p>
  </article>
</BaseLayout>
