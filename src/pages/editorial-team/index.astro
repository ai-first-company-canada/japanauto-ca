---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/sections/Navbar.astro';
import MenuDrawer from '../../components/sections/MenuDrawer.astro';
import CityPickerDialog from '../../components/sections/CityPickerDialog.astro';
import Footer from '../../components/sections/Footer.astro';
import Breadcrumb from '../../components/atoms/Breadcrumb.astro';

const url = Astro.url.toString();

// Articles are credited to the organization (no Person nodes): the earlier
// named editors were house pseudonyms, removed 2026-10-03.
const schemaLD = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://japanauto.ca/' },
      { '@type': 'ListItem', position: 2, name: 'Editorial team', item: url },
    ],
  },
  {
    '@type': 'AboutPage',
    '@id': `${url}#page`,
    name: 'Editorial team — japanauto.ca',
    description: 'Who writes japanauto.ca guides and how articles are credited.',
    url,
    inLanguage: 'en-CA',
    about: { '@id': 'https://japanauto.ca/#organization' },
    publisher: { '@id': 'https://japanauto.ca/#organization' },
  },
];
---
<BaseLayout
  title="Editorial team — japanauto.ca"
  description="Who writes the japanauto.ca buying guides, brand guides and glossary, how articles are credited, and how to reach the editors."
  canonical={url}
  schemaLD={schemaLD}
>
  <Navbar slot="navbar" />
  <MenuDrawer slot="menu-drawer" />
  <CityPickerDialog slot="city-picker" />
  <Footer slot="footer" />

  <Breadcrumb
    items={[
      { label: 'Home', href: '/' },
      { label: 'About', href: '/about/' },
      { label: 'Editorial team' },
    ]}
  />

  <section class="section" style="padding-top:8px">
    <h1 class="t-display-l" style="font-size:32px;line-height:40px;margin-bottom:12px">
      Editorial team
    </h1>
    <p class="t-body-m" style="font-size:15px;line-height:23px;max-width:720px;color:var(--color-ink-default);margin-bottom:14px">
      The buying guides, brand guides and glossary on japanauto.ca are produced by a small in-house team at the company that runs the marketplace, based in Calgary, Alberta. Articles are credited to <strong style="color:var(--color-ink-strong);font-weight:600">japanauto.ca Editorial</strong> rather than to individual bylines.
    </p>
    <p class="t-body-m" style="font-size:15px;line-height:23px;max-width:720px;color:var(--color-ink-default);margin-bottom:14px">
      Each page lists the sources its facts come from and shows when it was last reviewed. How we source, check and correct articles is set out in our <a href="/editorial-policy/" style="color:var(--color-ink-strong);text-decoration:underline">editorial policy</a>.
    </p>
    <p class="t-body-m" style="font-size:15px;line-height:23px;max-width:720px;color:var(--color-ink-default);margin-bottom:14px">
      Questions or corrections: <a href="mailto:editorial@japanauto.ca" style="color:var(--color-ink-strong);text-decoration:underline">editorial@japanauto.ca</a>.
    </p>
  </section>
</BaseLayout>
