---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Navbar from '../../../../components/sections/Navbar.astro';
import MenuDrawer from '../../../../components/sections/MenuDrawer.astro';
import CityPickerDialog from '../../../../components/sections/CityPickerDialog.astro';
import Footer from '../../../../components/sections/Footer.astro';
import Breadcrumb from '../../../../components/atoms/Breadcrumb.astro';
import PageHeading from '../../../../components/sections/PageHeading.astro';
import CityDirectoryGrid from '../../../../components/sections/CityDirectoryGrid.astro';
import AboutBrandSection from '../../../../components/sections/AboutBrandSection.astro';
import FaqSection from '../../../../components/sections/FaqSection.astro';
import AnswerCapsule from '../../../../components/sections/AnswerCapsule.astro';
import { modelMarket, fmtCad } from '../../../../lib/market';
import { BRAND_CONTENT, TIER_1_CITIES } from '../../../../data/brand-content';
import { MODELS_BY_BRAND } from '../../../../data/models-stubs';
import { liveCounts, snapshotLabel } from '../../../../data/live-counts';
import { LISTING_YEAR_MIN, generationsInWindow } from '../../../../lib/model-copy';

export function getStaticPaths() {
  const paths: Array<{ params: { make: string; model: string } }> = [];
  for (const make of Object.keys(MODELS_BY_BRAND)) {
    for (const model of MODELS_BY_BRAND[make]!) {
      paths.push({ params: { make, model: model.slug } });
    }
  }
  return paths;
}

const { make, model } = Astro.params;
const brand = BRAND_CONTENT[make!]!;
const modelInfo = MODELS_BY_BRAND[make!]!.find((m) => m.slug === model)!;

const cityCards = TIER_1_CITIES.map((c) => ({
  slug: c.slug,
  name: c.name,
  province: c.province,
  count: liveCounts.cityModel(c.slug, make!, model!),
}));

const totalListings = liveCounts.brandModel(make!, model!);
const citiesLive = cityCards.filter((c) => c.count > 0);
const citiesOnboarding = cityCards.filter((c) => c.count === 0);

const title = `Used ${brand.name} ${modelInfo.name} across Canada — japanauto.ca`;
const description = totalListings > 0
  ? `Used ${brand.name} ${modelInfo.name} for sale across Canada: ${totalListings} live listing${totalListings === 1 ? '' : 's'} from licensed, VIN-checked local dealers.`
  : `Used ${brand.name} ${modelInfo.name} listings from licensed dealers in Toronto, Montreal, Vancouver, Calgary, Edmonton and Ottawa. Every car has a checked VIN.`;
const canonical = `https://japanauto.ca/used-cars/${make}/${model}/`;

const aboutTitle = `About the ${brand.name} ${modelInfo.name}`;
const gens = generationsInWindow(make!, model!);

// Answer capsule: generations in the listing window, plus the Calgary price
// pilot as the one city with public market data so far.
const calgary = modelMarket('calgary', make!, model!);
const capsule: string[] = [gens
  ? `A used ${brand.name} ${modelInfo.name} on japanauto.ca is model year ${LISTING_YEAR_MIN} or newer, which covers the ${gens}.`
  : `A used ${brand.name} ${modelInfo.name} on japanauto.ca is model year ${LISTING_YEAR_MIN} or newer.`];
if (calgary) {
  const r0 = calgary.rows[calgary.rows.length - 1]!, r1 = calgary.rows[0]!;
  capsule.push(`In Calgary, where we publish asking-price data, the median dealer ask runs from ${fmtCad(r0.dealer.p50)} for a ${r0.year} to ${fmtCad(r1.dealer.p50)} for a ${r1.year}.`);
}
const topCity = [...cityCards].sort((a, b) => b.count - a.count)[0]!;
const aboutParagraphs = [
  `This page collects used ${brand.name} ${modelInfo.name} listings from licensed dealers in ${TIER_1_CITIES.length} Canadian cities. Each one is a real car with its year, kilometres and trim, so you can compare it with what else is for sale locally.`,
  gens
    ? `Dealers can list model years ${LISTING_YEAR_MIN} and newer, which for the ${modelInfo.name} covers ${gens}. Pick a city below to see what is for sale there.`
    : `Dealers can list model years ${LISTING_YEAR_MIN} and newer (a rolling 10-year limit). Pick a city below to see what is for sale there.`,
];

const modelFaqs = [
  {
    q: `Is the ${brand.name} ${modelInfo.name} a good used buy?`,
    a: `It can be. ${brand.name} has a good record for resale value and long-term reliability, but the individual car matters more than the badge: check the service history, the VIN report and open recalls, and get an independent inspection.`,
  },
  {
    q: `Which Canadian city has the most used ${brand.name} ${modelInfo.name}?`,
    a: topCity.count > 0
      ? `Right now it is ${topCity.name}, with ${topCity.count} live listing${topCity.count === 1 ? '' : 's'}. The city cards below show the current count for each market.`
      : `None has live ${modelInfo.name} stock yet. The city cards below show the count for each market as dealers start listing.`,
  },
  {
    q: `What's the average price for a used ${brand.name} ${modelInfo.name}?`,
    a: `It depends on year, kilometres, trim and city, so a national average would hide more than it shows. Each city page lists dealers' actual asking prices.`,
  },
];

const schemaLD = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://japanauto.ca/' },
      { '@type': 'ListItem', position: 2, name: brand.name, item: `https://japanauto.ca/used-cars/${make}/` },
      { '@type': 'ListItem', position: 3, name: modelInfo.name, item: canonical },
    ],
  },
  {
    '@type': 'ItemList',
    name: `${brand.name} ${modelInfo.name} availability across Canada`,
    itemListElement: cityCards.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${brand.name} ${modelInfo.name} in ${c.name}`,
      url: `https://japanauto.ca/${c.slug}/${make}/${model}/`,
    })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: modelFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const subtitleHtml = totalListings > 0
  ? `<span class="num">${totalListings}</span> ${modelInfo.name} listing${totalListings === 1 ? '' : 's'} across <span class="num">${citiesLive.length}</span> Canadian ${citiesLive.length === 1 ? 'city' : 'cities'} · ${snapshotLabel}`
  : `No live ${modelInfo.name} listings yet · model years ${LISTING_YEAR_MIN}+`;
---
<BaseLayout {title} {description} {canonical} {schemaLD}>
  <Navbar slot="navbar" />
  <MenuDrawer slot="menu-drawer" />
  <CityPickerDialog slot="city-picker" />
  <Footer slot="footer" />

  <h1 class="sr-only">{`Used ${brand.name} ${modelInfo.name} across Canada`}</h1>

  <Breadcrumb items={[
    { label: 'Home', href: '/' },
    { label: brand.name, href: `/used-cars/${make}/` },
    { label: modelInfo.name },
  ]} />

  <PageHeading
    title={`${brand.name} ${modelInfo.name} across Canada`}
    subtitle={subtitleHtml}
  />

  <AnswerCapsule paragraphs={capsule} />
  {calgary && (
    <p class="gutter t-body-s" style="margin:0 0 8px;font-size:14px">
      <a href={`/calgary/${make}/${model}/`} style="color:var(--color-ink-strong);text-decoration:underline">{`${modelInfo.name} prices by year in Calgary`}</a>
    </p>
  )}

  {citiesLive.length > 0 && (
    <CityDirectoryGrid
      brandSlug={`${make}/${model}`}
      brandName={`${brand.name} ${modelInfo.name}`}
      cities={citiesLive}
    />
  )}

  {citiesOnboarding.length > 0 && (
    <section style="padding:0 16px 32px">
      <h2 class="sr-only">{`${brand.name} ${modelInfo.name}: cities with no listings yet`}</h2>
      {citiesLive.length === 0 && (
        <div class="card" style="padding:20px;margin-bottom:12px;text-align:left">
          <h3 class="t-h-m" style="font-size:17px">No {modelInfo.name} listed yet</h3>
          <p class="t-caption" style="margin-top:8px">Dealers in these cities are still being set up. Their cars will appear here first.</p>
          <a href="/dealer/signup/" class="t-caption" style="display:inline-block;margin-top:12px">List your inventory →</a>
        </div>
      )}
      <div style="display:grid;grid-template-columns:repeat(2, 1fr);gap:12px">
        {citiesOnboarding.map((c) => (
          <a
            href={`/${c.slug}/${make}/${model}/`}
            class="card"
            style="display:flex;flex-direction:column;justify-content:space-between;padding:20px;min-height:96px;text-align:left"
          >
            <h3 class="t-h-m" style="font-size:17px">{c.name}</h3>
            <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-top:auto;gap:8px">
              <span class="t-caption" style="font-size:10px">No listings yet</span>
              <span class="t-caption t-mono" style="font-size:10px">{c.province}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <AboutBrandSection title={aboutTitle} paragraphs={aboutParagraphs} guide={{ href: `/brands/${make}/`, label: `Read our ${brand.name} buyer's guide` }} />

  <FaqSection
    items={modelFaqs}
    heading={`Common questions about the ${brand.name} ${modelInfo.name}`}
  />
</BaseLayout>
