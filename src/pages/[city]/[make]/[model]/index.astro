---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Navbar from '../../../../components/sections/Navbar.astro';
import MenuDrawer from '../../../../components/sections/MenuDrawer.astro';
import CityPickerDialog from '../../../../components/sections/CityPickerDialog.astro';
import Footer from '../../../../components/sections/Footer.astro';
import Breadcrumb from '../../../../components/atoms/Breadcrumb.astro';
import PageHeading from '../../../../components/sections/PageHeading.astro';
import FilterPillBar from '../../../../components/sections/FilterPillBar.astro';
import CatalogList from '../../../../components/sections/CatalogList.astro';
import CatalogPagination from '../../../../components/sections/CatalogPagination.astro';
import ModelCrossLinks from '../../../../components/sections/ModelCrossLinks.astro';
import FaqSection from '../../../../components/sections/FaqSection.astro';
import AnswerCapsule from '../../../../components/sections/AnswerCapsule.astro';
import { modelMarket, fmtCad, fmtDate, MARKET_COMPUTED_ON, PROVINCE_FACTS } from '../../../../lib/market';
import YearFilterDialog from '../../../../components/sections/YearFilterDialog.astro';
import SortFilterDialog from '../../../../components/sections/SortFilterDialog.astro';
import { BRAND_CONTENT, TIER_1_CITIES, DEALER_REGULATOR } from '../../../../data/brand-content';
import { LISTING_YEAR_MIN, generationsInWindow } from '../../../../lib/model-copy';
import { MODELS_BY_BRAND, getModelsForCity } from '../../../../data/models-stubs';
import { getCatalogForModelCity } from '../../../../data/catalog-stubs';

export function getStaticPaths() {
  const paths: Array<{ params: { city: string; make: string; model: string } }> = [];
  for (const city of TIER_1_CITIES) {
    for (const make of Object.keys(MODELS_BY_BRAND)) {
      for (const model of MODELS_BY_BRAND[make]!) {
        paths.push({ params: { city: city.slug, make, model: model.slug } });
      }
    }
  }
  return paths;
}

const { make, model, city } = Astro.params;
const brand = BRAND_CONTENT[make!]!;
const cityInfo = TIER_1_CITIES.find((c) => c.slug === city)!;
const modelInfo = MODELS_BY_BRAND[make!]!.find((m) => m.slug === model)!;
const catalog = getCatalogForModelCity(make!, model!, modelInfo.name, city!);
const cityShort = `${cityInfo.name}, ${cityInfo.province}`;

const otherModels = getModelsForCity(make!, city!);
const reg = DEALER_REGULATOR[cityInfo.province]!;
const gens = generationsInWindow(make!, model!);
const prices = [...catalog.boosted, ...catalog.organic].map((l) => l.price).filter((p) => p > 0);
const priceMin = prices.length ? Math.min(...prices) : null;
const priceMax = prices.length ? Math.max(...prices) : null;
const market = modelMarket(city!, make!, model!);
const prov = PROVINCE_FACTS[cityInfo.province]!;
const label = `${brand.name} ${modelInfo.name}`;

// Answer capsule: what years exist, what they cost here (Calgary pilot), who
// licenses the seller and what tax applies. Every clause is data-backed.
const capsule: string[] = [];
capsule.push(gens
  ? `Dealers can list a used ${label} from model year ${LISTING_YEAR_MIN} on, which covers the ${gens}.`
  : `Dealers can list a used ${label} from model year ${LISTING_YEAR_MIN} on.`);
if (market) {
  const newest = market.rows[0]!;
  const oldest = market.rows[market.rows.length - 1]!;
  capsule.push(`${cityInfo.name} dealers currently advertise about ${market.dealerCars} used ${modelInfo.name}s from ${market.yearFrom}–${market.yearTo}. The median asking price is ${fmtCad(oldest.dealer.p50)} for a ${oldest.year} and ${fmtCad(newest.dealer.p50)} for a ${newest.year}.`);
}
capsule.push(`Buy from a dealer licensed by ${prov.regulator}. ${prov.tax}`);
if (catalog.totalCount === 0) {
  capsule.push(`No ${cityInfo.name} dealer has posted a ${modelInfo.name} on japanauto.ca yet.`);
}

const modelFaqs = [
  {
    q: `Is the ${brand.name} ${modelInfo.name} reliable?`,
    a: `${brand.name} has a strong reliability record, but problems tend to cluster by generation and powertrain, so judge the car in front of you. Ask for service records, check the VIN for open recalls, and book an independent pre-purchase inspection in ${cityInfo.name} before you pay.`,
  },
  {
    q: `What years of ${brand.name} ${modelInfo.name} are available?`,
    a: gens
      ? `Dealers can list model years ${LISTING_YEAR_MIN} and newer. For the ${modelInfo.name} that means ${gens}. Use the year filter to see what is listed in ${cityInfo.name} right now.`
      : `Dealers can list model years ${LISTING_YEAR_MIN} and newer (a rolling 10-year limit). Use the year filter to see what is listed in ${cityInfo.name} right now.`,
  },
  {
    q: `Does the ${brand.name} ${modelInfo.name} have AWD?`,
    a: make === 'subaru'
      ? `Yes. Symmetrical AWD is standard on the ${modelInfo.name}, as on every Subaru model listed here.`
      : `It depends on the year and trim. Each listing shows the drivetrain in its spec line, so check there before you contact the dealer.`,
  },
  {
    q: `What's the typical price range for a used ${brand.name} ${modelInfo.name}?`,
    a: market
      ? `In ${cityInfo.name}, the median dealer asking price runs from ${fmtCad(market.rows[market.rows.length - 1]!.dealer.p50)} for a ${market.rows[market.rows.length - 1]!.year} to ${fmtCad(market.rows[0]!.dealer.p50)} for a ${market.rows[0]!.year}, based on online listings as of ${fmtDate(MARKET_COMPUTED_ON.dealer)}. Kilometres, trim and condition explain most of the spread within a year.`
      : priceMin !== null && priceMax !== null
      ? `Right now ${cityInfo.name} dealers are asking CA$${priceMin.toLocaleString('en-US')} to CA$${priceMax.toLocaleString('en-US')} across ${prices.length} listing${prices.length === 1 ? '' : 's'}. Year, kilometres and trim explain most of the spread.`
      : `There are no ${cityInfo.name} listings to price against yet. Year, kilometres and trim move the price most; the national ${modelInfo.name} page shows other cities.`,
  },
];

const title = market
  ? `Used ${label} Prices in ${cityInfo.name} by Year — japanauto.ca`
  : `Used ${brand.name} ${modelInfo.name} in ${cityInfo.name}, ${cityInfo.province} — japanauto.ca`;
// Real counts only — zero inventory gets honest "onboarding" copy, never an
// invented number (LAUNCH-CHECKLIST §1).
const description = market && catalog.totalCount === 0
  ? `Used ${label} asking prices in ${cityInfo.name}: median ${fmtCad(market.rows[market.rows.length - 1]!.dealer.p50)} (${market.rows[market.rows.length - 1]!.year}) to ${fmtCad(market.rows[0]!.dealer.p50)} (${market.rows[0]!.year}), by model year, from dealer listings.`
  : catalog.totalCount > 0
  ? `${catalog.totalCount} used ${brand.name} ${modelInfo.name} listing${catalog.totalCount === 1 ? '' : 's'} in ${cityInfo.name}. ${reg.short}-licensed dealers, VIN-checked vehicles, prices in CA$.`
  : `Used ${brand.name} ${modelInfo.name} for sale in ${cityInfo.name} from ${reg.short}-licensed dealers. No live listings yet; cars appear here once local dealers post them.`;
const canonical = `https://japanauto.ca/${city}/${make}/${model}/`;

const allListings = [...catalog.boosted, ...catalog.organic];
const schemaLD = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://japanauto.ca/' },
      { '@type': 'ListItem', position: 2, name: cityInfo.name, item: `https://japanauto.ca/${city}/` },
      { '@type': 'ListItem', position: 3, name: brand.name, item: `https://japanauto.ca/${city}/${make}/` },
      { '@type': 'ListItem', position: 4, name: modelInfo.name, item: canonical },
    ],
  },
  // Vehicle/Offer markup only when real rows exist — catalog data is live D1
  // (catalog-live.json) since 2026-06-12; an empty combo emits no ItemList.
  ...(allListings.length === 0 ? [] : [{
    '@type': 'ItemList',
    name: `Used ${brand.name} ${modelInfo.name} in ${cityInfo.name}`,
    numberOfItems: catalog.totalCount,
    itemListElement: allListings.map((l, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Vehicle',
        name: `${l.year} ${l.make} ${l.model} ${l.trim}`.trim(),
        vehicleModelDate: String(l.year),
        mileageFromOdometer: { '@type': 'QuantitativeValue', value: l.km, unitCode: 'KMT' },
        ...(l.transmission ? { vehicleTransmission: l.transmission } : {}),
        ...(l.drive ? { driveWheelConfiguration: l.drive } : {}),
        url: `https://japanauto.ca/used-cars/listing/${l.slug}/`,
        offers: {
          '@type': 'Offer',
          price: l.price,
          priceCurrency: 'CAD',
          availability: 'https://schema.org/InStock',
          seller: { '@type': 'AutoDealer', name: l.dealer },
        },
      },
    })),
  }]),
  {
    '@type': 'Place',
    name: cityInfo.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: cityInfo.name,
      addressRegion: cityInfo.province,
      addressCountry: 'CA',
    },
  },
  ...(market ? [{
    '@type': 'Dataset',
    name: `Used ${label} asking prices in ${cityInfo.name}`,
    description: `Median and interquartile asking prices of used ${label} dealer listings in ${cityInfo.name}, ${cityInfo.province}, by model year (each year aggregates model year ±1), with exact listing counts.`,
    spatialCoverage: { '@type': 'Place', name: `${cityInfo.name}, ${cityInfo.province}, Canada` },
    temporalCoverage: MARKET_COMPUTED_ON.dealer ?? undefined,
    variableMeasured: ['median asking price (CAD)', '25th–75th percentile asking price (CAD)', 'listing count'],
    creator: { '@id': 'https://japanauto.ca/#organization' },
    isAccessibleForFree: true,
    url: canonical,
  }] : []),
  // The featured slot is a house ad (brand-site link, no price, no seller —
  // ADR-0013) and must not emit Offer markup. Paid featured_slots get their
  // own JSON-LD design when the D1 catalog wiring lands.
  {
    '@type': 'FAQPage',
    mainEntity: modelFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const subtitleHtml = catalog.totalCount > 0
  ? `<span class="num">${catalog.totalCount}</span> listing${catalog.totalCount === 1 ? '' : 's'} from <span class="num">${catalog.dealerCount}</span> dealer${catalog.dealerCount === 1 ? '' : 's'} · Updated with every listing`
  : `Model years ${LISTING_YEAR_MIN}+ from ${reg.short}-licensed ${cityInfo.name} dealers`;
const visibleCount = catalog.boosted.length + catalog.organic.length;
---
<BaseLayout
  {title}
  {description}
  {canonical}
  {schemaLD}
>
  <Navbar slot="navbar" cityShort={cityShort} />
  <MenuDrawer slot="menu-drawer" cityShort={cityShort} cityName={cityInfo.name} />
  <CityPickerDialog slot="city-picker" />
  <YearFilterDialog slot="filter-dialogs" />
  <SortFilterDialog slot="filter-dialogs" />
  <Footer slot="footer" />

  <h1 class="sr-only">{`Used ${brand.name} ${modelInfo.name} in ${cityInfo.name}, ${cityInfo.province}`}</h1>

  <Breadcrumb items={[
    { label: 'Home', href: '/' },
    { label: cityInfo.name, href: `/${city}/` },
    { label: brand.name, href: `/${city}/${make}/` },
    { label: modelInfo.name },
  ]} />

  <PageHeading
    title={`Used ${brand.name} ${modelInfo.name} in ${cityShort}`}
    subtitle={subtitleHtml}
  />

  <AnswerCapsule paragraphs={capsule} market={market} modelLabel={label} cityName={cityInfo.name} />

  <FilterPillBar />

  {visibleCount > 0 && (
    <p
      id="catalog-counter"
      class="t-body-s ink-muted"
      style="padding:12px 16px 0;font-size:12px"
    >
      Showing <span class="num">{visibleCount}</span> of <span class="num">{catalog.totalCount}</span> listings
    </p>
  )}

  <CatalogList
    featured={catalog.featured}
    boosted={catalog.boosted}
    organic={catalog.organic}
    citySlug={city!}
    emptyContext={{ modelLabel: `${brand.name} ${modelInfo.name}`, cityName: cityInfo.name, brandSlug: make!, brandName: brand.name }}
  />

  <CatalogPagination initialShown={10} />

  <ModelCrossLinks
    brandSlug={make!}
    brandName={brand.name}
    citySlug={city!}
    cityName={cityInfo.name}
    currentModelSlug={model!}
    crossLinks={otherModels}
  />

  <FaqSection
    items={modelFaqs}
    heading={`Common questions about ${brand.name} ${modelInfo.name}`}
  />

  <script is:inline>
    (function () {
      window.applyCatalogFilters = function () {
        var params = new URLSearchParams(window.location.search);
        var rawYear = params.get('year') || '';
        var yearFilter = rawYear.split(',').filter(Boolean);
        var sortKey = params.get('sort') || 'newest';
        var grid = document.getElementById('catalog-grid');
        if (!grid) return;
        var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-year]'));
        var visible = 0;
        for (var i = 0; i < cards.length; i++) {
          var card = cards[i];
          var year = card.getAttribute('data-year');
          var matchYear = yearFilter.length === 0 || yearFilter.indexOf(year) !== -1;
          if (matchYear) {
            card.style.display = '';
            visible++;
          } else {
            card.style.display = 'none';
          }
        }
        var visibleCards = cards.filter(function (c) { return c.style.display !== 'none'; });
        visibleCards.sort(function (a, b) {
          var aTier = a.getAttribute('data-tier') === 'boosted' ? 0 : 1;
          var bTier = b.getAttribute('data-tier') === 'boosted' ? 0 : 1;
          if (aTier !== bTier) return aTier - bTier;
          if (sortKey === 'price-asc') {
            return Number(a.getAttribute('data-price')) - Number(b.getAttribute('data-price'));
          }
          if (sortKey === 'price-desc') {
            return Number(b.getAttribute('data-price')) - Number(a.getAttribute('data-price'));
          }
          if (sortKey === 'km-asc') {
            return Number(a.getAttribute('data-mileage')) - Number(b.getAttribute('data-mileage'));
          }
          if (sortKey === 'year-desc') {
            return Number(b.getAttribute('data-year')) - Number(a.getAttribute('data-year'));
          }
          return 0;
        });
        for (var j = 0; j < visibleCards.length; j++) {
          grid.appendChild(visibleCards[j]);
        }
        var counter = document.getElementById('catalog-counter');
        if (counter) {
          counter.innerHTML = 'Showing <span class="num">' + visible + '</span> of <span class="num">' + cards.length + '</span> listings';
        }
        document.dispatchEvent(new CustomEvent('catalog-filtered'));
      };

      function init() {
        if (window.location.search) {
          window.applyCatalogFilters();
        } else {
          document.dispatchEvent(new CustomEvent('catalog-filtered'));
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</BaseLayout>
