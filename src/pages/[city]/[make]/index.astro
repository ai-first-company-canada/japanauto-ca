---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/sections/Navbar.astro';
import MenuDrawer from '../../../components/sections/MenuDrawer.astro';
import CityPickerDialog from '../../../components/sections/CityPickerDialog.astro';
import Footer from '../../../components/sections/Footer.astro';
import Breadcrumb from '../../../components/atoms/Breadcrumb.astro';
import PageHeading from '../../../components/sections/PageHeading.astro';
import ModelsGridSection from '../../../components/sections/ModelsGridSection.astro';
import AboutBrandSection from '../../../components/sections/AboutBrandSection.astro';
import AnswerCapsule from '../../../components/sections/AnswerCapsule.astro';
import { brandMarket, fmtCad, PROVINCE_FACTS } from '../../../lib/market';
import { MODELS_BY_BRAND } from '../../../data/models-stubs';
import FaqSection from '../../../components/sections/FaqSection.astro';
import CrossLinksBand from '../../../components/sections/CrossLinksBand.astro';
import { BRAND_CONTENT, TIER_1_CITIES, DEALER_REGULATOR } from '../../../data/brand-content';
import { getModelsForCity } from '../../../data/models-stubs';
import { liveCounts } from '../../../data/live-counts';
import { faqPage } from '../../../lib/schema-graph';

export function getStaticPaths() {
  const brands = Object.keys(BRAND_CONTENT);
  const cities = TIER_1_CITIES.map((c) => c.slug);
  return cities.flatMap((city) =>
    brands.map((make) => ({ params: { city, make } })),
  );
}

const { make, city } = Astro.params;
const brand = BRAND_CONTENT[make!]!;
const cityInfo = TIER_1_CITIES.find((c) => c.slug === city)!;
const models = getModelsForCity(make!, city!);
const liveCount = liveCounts.cityBrand(city!, make!);
const reg = DEALER_REGULATOR[cityInfo.province]!;
const prov = PROVINCE_FACTS[cityInfo.province]!;

// Answer capsule: which models actually sell here (Calgary pilot market data)
// and the licensing/tax facts for the province.
const ranked = brandMarket(city!, make!, MODELS_BY_BRAND[make!] ?? []);
const capsule: string[] = [];
if (ranked.length > 0) {
  const top = ranked.slice(0, 3).map((m) => {
    const r = m.market.rows.find((x) => x.year === m.market.yearTo - 3) ?? m.market.rows[0]!;
    return `${m.name} (about ${m.market.dealerCars} cars; median ask ${fmtCad(r.dealer.p50)} for a ${r.year})`;
  });
  capsule.push(`The most advertised used ${brand.name} models at ${cityInfo.name} dealers, model years ${ranked[0]!.market.yearFrom}–${ranked[0]!.market.yearTo}: ${top.join(', ')}. Each model page below has prices by year.`);
} else {
  capsule.push(`japanauto.ca covers ${models.length} ${brand.name} models in ${cityInfo.name}: ${models.map((m) => m.name).join(', ')}.`);
}
capsule.push(`Buy from a dealer licensed by ${prov.regulator}. ${prov.tax}`);

const title = `Used ${brand.name} in ${cityInfo.name}, ${cityInfo.province} — japanauto.ca`;
const description = liveCount > 0
  ? `Find used ${brand.name} cars in ${cityInfo.name}. ${liveCount} live ${brand.name} listing${liveCount === 1 ? '' : 's'} from ${reg.short}-licensed local dealers. VIN-checked.`
  : `Used ${brand.name} cars in ${cityInfo.name}, ${cityInfo.province}: ${models.slice(0, 3).map((m) => m.name).join(', ')} and ${models.length - 3} other models from ${reg.short}-licensed local dealers.`;
const canonical = `https://japanauto.ca/${city}/${make}/`;

const faqLd = faqPage(brand.faqs.map((f) => f.q), brand.faqs.map((f) => f.a));
const schemaLD = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://japanauto.ca/' },
      { '@type': 'ListItem', position: 2, name: cityInfo.name, item: `https://japanauto.ca/${city}/` },
      { '@type': 'ListItem', position: 3, name: brand.name, item: canonical },
    ],
  },
  ...(faqLd ? [faqLd] : []),
  {
    '@type': 'ItemList',
    name: `${brand.name} models available in ${cityInfo.name}`,
    itemListElement: models.map((m, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${brand.name} ${m.name}`,
      url: `https://japanauto.ca/${city}/${make}/${m.slug}/`,
    })),
  },
  {
    '@type': 'Place',
    name: cityInfo.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: cityInfo.name,
      addressRegion: cityInfo.province,
      addressCountry: 'CA',
    },
  },
];

const subtitleHtml = liveCount > 0
  ? `<span class="num">${liveCount}</span> used ${brand.name} ${liveCount === 1 ? 'car' : 'cars'} live from local dealers`
  : `${models.length} ${brand.name} models · no ${cityInfo.name} listings yet`;
---
<BaseLayout
  {title}
  {description}
  {canonical}
  {schemaLD}
>
  <Navbar slot="navbar" cityShort={`${cityInfo.name}, ${cityInfo.province}`} />
  <MenuDrawer slot="menu-drawer" cityShort={`${cityInfo.name}, ${cityInfo.province}`} cityName={cityInfo.name} />
  <CityPickerDialog slot="city-picker" />
  <Footer slot="footer" />

  <h1 class="sr-only">{`Used ${brand.name} in ${cityInfo.name}, ${cityInfo.province}`}</h1>

  <Breadcrumb items={[
    { label: 'Home', href: '/' },
    { label: cityInfo.name, href: `/${city}/` },
    { label: brand.name },
  ]} />

  <PageHeading
    title={`${brand.name} models in ${cityInfo.name}`}
    subtitle={subtitleHtml}
  />

  <AnswerCapsule paragraphs={capsule} />

  <ModelsGridSection models={models} brandSlug={make!} citySlug={city!} />

  <AboutBrandSection title={brand.aboutTitle} paragraphs={brand.aboutParagraphs} guide={{ href: `/brands/${make}/`, label: `Read our ${brand.name} buyer's guide` }} />

  <FaqSection items={brand.faqs} heading={`Common questions about ${brand.name}`} />

  <CrossLinksBand
    brandSlug={make!}
    brandName={brand.name}
    currentCitySlug={city!}
    citiesList={TIER_1_CITIES}
  />
</BaseLayout>
